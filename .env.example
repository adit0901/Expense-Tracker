# FinTrack environment configuration. Copy to .env and adjust.
# APP_ENV: development | test | production
APP_ENV=development

# PostgreSQL (local dev cluster from scripts/dev-db.sh listens on 54329)
DATABASE_URL=postgresql+psycopg://fintrack_app:fintrack_app@localhost:54329/fintrack
# Owner connection used by Alembic migrations
MIGRATION_DATABASE_URL=postgresql+psycopg://fintrack:fintrack@localhost:54329/fintrack

# Auth — MUST be changed in production (startup fails on the default)
JWT_SECRET=change-me-dev-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Email (Mailpit locally: SMTP 1025, UI 8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=FinTrack <no-reply@fintrack.local>
FRONTEND_BASE_URL=http://localhost:5173

# Redis / ARQ worker
REDIS_URL=redis://localhost:6379/0

# Receipt uploads
UPLOAD_DIR=./data/uploads
